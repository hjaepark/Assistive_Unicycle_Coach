<mujoco model="Unicycle Pendulum">
    <asset>
        <mesh name="wheel" file="UNI_WHEEL.stl" scale="0.01 0.01 0.01"/>
        <mesh name="frame" file="UNI_FRAME.stl" scale="0.01 0.01 0.01"/>
        <texture name="checkerboard" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".3 .4 .5" width="512" height="512"/>
        <material name="checkerboard" texture="checkerboard" texrepeat="5 5" texuniform="true"/>
    </asset>

    <compiler inertiafromgeom="true"/>
    <option gravity="0 0 -9.81" integrator="RK4" timestep="0.005"/>
    <worldbody>
        <geom name="floor" pos="0 0 0" size="5 5 0.01" type="plane" material="checkerboard" friction="4.0 1.0 0.05"/>
        <geom name="floor_goal_right" pos="6.5 0 0" size="1.5 5 0.01" type="plane" rgba="0.5 0.5 0.98 1"/>

        <light pos="0 0 100" dir="0 0 -1" castshadow="false"/>

        <!-- Unicycle Pendulum Model -->
        <body name="unicycle" pos="0 0 0.266">
            <joint name="free_joint" type="free"/>

            <!-- Frame mass = 3.0 kg -->
            <body name="frame">
                <geom type="mesh" mesh="frame" pos="0 0 0.26" euler="0 90 90" mass="3.0" rgba="0.5 0.5 0.5 1"/>

                <!-- Seat + seat post mass = 0.5 kg -->
                <body name="seat_post" pos="0 0 0.55">
                    <geom name="seat_post" type="cylinder" fromto="0 0 0 0 0 -0.18" size="0.015" mass="0.5" rgba="0.5 0.5 0.5 1"/>
                </body>
            </body>

            <!-- Pendulum with sphere at top mass = 2.0 kg -->
            <body name="pendulum" pos="0 0 0.565">
                <joint name="pendulum_joint" type="hinge" axis="0 1 0" frictionloss="0.5" damping="1.5"/>
                <geom name="rod" type="capsule" fromto="0 0 0 0 0 0.3" size="0.015" mass="1.5" rgba="1 0.5 0.5 1"/>
                <geom name="sphere_mass" type="sphere" pos="0 0 0.3" size="0.04" mass="0.3" rgba=".8 .2 .2 1"/>
            </body>

            <!-- Wheel mass = 1.5 kg -->

            <body name="wheel" pos="0 0 0">
                <joint name="wheel_joint" type="hinge" axis="0 1 0" frictionloss="1.5" damping="0.9"/>
                <geom type="mesh" mesh="wheel" pos="0 0 0" euler="0 0 90" mass="1.5" rgba="0.8 0.8 0.8 0.6" friction="4.0 1.0 0.05"/>
                <geom name="wheel_marker" type="capsule" size="0.01 0.24" pos="0 0 0" euler="0 0 90" rgba="0.5 0.5 0.5 1"/>
            </body>
        </body>

    </worldbody>

    <actuator>
        <motor name="wheel_motor" joint="wheel_joint" gear="25" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="roll_control_motor" joint="free_joint" gear="0 0 0 10 0 0" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="pitch_control_motor" joint="free_joint" gear="0 0 0 0 20 0" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="yaw_control_motor" joint="free_joint" gear="0 0 0 0 0 10" ctrllimited="true" ctrlrange="-1 1"/>
    </actuator>
</mujoco>